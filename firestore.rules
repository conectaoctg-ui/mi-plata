rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regla de seguridad para el espacio familiar compartido
    match /hogares/{hogarId} {
      // Permite lectura y escritura si el usuario está autenticado con Google
      // y su correo electrónico forma parte de la lista blanca familiar autorizada
      allow read, write: if request.auth != null && (
        resource == null || 
        request.auth.token.email.lower() in resource.data.whitelist ||
        request.auth.token.email.lower() == resource.data.modificadoPor
      );
    }

    // Regla de seguridad para documentos individuales de usuario
    match /usuarios/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
